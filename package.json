{
  "name": "change-detection-playground",
  "private": true,
  "scripts": {
    "install:all": "npm install && npm --prefix v19 install && npm --prefix v22 install",
    "start": "concurrently --names v19,v22 --prefix-colors red,blue \"npm:start:19\" \"npm:start:22\"",
    "start:19": "npm --prefix v19 start",
    "start:22": "npm --prefix v22 start",
    "build": "node scripts/build.mjs",
    "test": "npm --prefix v22 test -- --watch=false",
    "preview": "node scripts/preview.mjs"
  },
  "devDependencies": {
    "concurrently": "10.0.6"
  }
}
